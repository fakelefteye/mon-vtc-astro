---
// src/layouts/Layout.astro
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/config/site.config';

export interface Props {
    title: string;
    description: string;
    keywords?: string;
}

const { title, description } = Astro.props;
const googleMapsApiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;

const currentLang = Astro.currentLocale || 'fr';
const locales = ['fr', 'en-gb', 'es'];

function getAlternatePath(locale: string, currentPath: string): string {
    if (locale === 'fr') {
        return currentPath.replace(/^\/(en-gb|es)\/?/, '/');
    }
    const neutralPath = currentPath.replace(/^\/(en-gb|es)\/?/, '/');
    return `/${locale}${neutralPath === '/' ? '' : neutralPath}`;
}

const { accentColor, darkBg, font } = siteConfig.theme;
const { faviconBaseUrl, name: companyName } = siteConfig.company;
const gaId = siteConfig.seo.googleAnalyticsId;
---
<!DOCTYPE html>
<html lang={currentLang}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/png" href={`${faviconBaseUrl}/favicon-96x96.png`} sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href={`${faviconBaseUrl}/favicon.svg`} />
    <link rel="shortcut icon" href={`${faviconBaseUrl}/favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${faviconBaseUrl}/apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-title" content={companyName} />
    <link rel="manifest" href={`${faviconBaseUrl}/site.webmanifest`} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href={`https://fonts.googleapis.com/css2?family=${font}:wght@400;700&display=swap`} rel="stylesheet">

    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/cookieconsent@3/build/cookieconsent.min.css" />

    {locales.map((locale) => (
        <link
            rel="alternate"
            hreflang={locale}
            href={new URL(getAlternatePath(locale, Astro.url.pathname), Astro.site).href}
        />
    ))}
    <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(getAlternatePath('fr', Astro.url.pathname), Astro.site).href}
    />

    <script src="https://js.stripe.com/v3/" async defer onload="window.dispatchEvent(new CustomEvent('stripe-loaded'))"></script>

    <script is:inline define:vars={{ googleMapsApiKey }}>
        function initMap() {
            window.dispatchEvent(new CustomEvent('maps-loaded'));
        }
        window.initMap = initMap;
    </script>
    <script
        async defer
        src={`https://maps.googleapis.com/maps/api/js?key=${googleMapsApiKey}&libraries=places&callback=initMap`}
    ></script>

    <style define:vars={{ accentColor, darkBg, font }} is:global>
        :root {
            --accent: var(--accentColor);
            --dark-bg: var(--darkBg);
            --text-color: #333;
            --header-bg: var(--darkBg);
            --header-text: #ffffff;
        }
        html { font-family: var(--font), sans-serif; scroll-behavior: smooth; }
        body { margin: 0; min-height: 100vh; display: flex; flex-direction: column; }
        main { flex-grow: 1; padding: 2rem 0; }
        header { background-color: var(--header-bg); color: var(--header-text); padding: 1rem 0; }
        header a { color: var(--header-text); text-decoration: none; }
        header a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <Header currentPath={Astro.url.pathname} />
    <main><slot /></main>
    <Footer currentPath={Astro.url.pathname} />

    <script src="https://cdn.jsdelivr.net/npm/cookieconsent@3/build/cookieconsent.min.js" data-cfasync="false"></script>

    <script is:inline define:vars={{ gaId, accentColor, darkBg, companyName }}>
        function loadGoogleAnalytics() {
            if (!gaId || window._gaLoaded) return;
            const script = document.createElement('script');
            script.async = true;
            script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
            document.head.appendChild(script);
            window.dataLayer = window.dataLayer || [];
            function gtag() { window.dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', gaId);
            window._gaLoaded = true;
        }

        window.addEventListener('load', function () {
            window.cookieconsent.initialise({
                palette: {
                    popup: { background: darkBg, text: '#ffffff' },
                    button: { background: accentColor, text: '#ffffff' },
                },
                theme: 'edgeless',
                position: 'bottom-right',
                type: 'opt-in',
                content: {
                    message: 'Nous utilisons des cookies pour analyser le trafic et améliorer votre expérience.',
                    allow: 'Accepter tout',
                    deny: 'Refuser',
                    link: 'En savoir plus',
                    href: '/politique-de-cookie',
                },
                onInitialise: function () {
                    if (this.hasConsented()) loadGoogleAnalytics();
                },
                onStatusChange: function (_status) {
                    if (this.hasConsented()) loadGoogleAnalytics();
                },
            });
        });
    </script>
</body>
</html>
