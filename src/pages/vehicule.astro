---
import Layout from '@/layouts/Layout.astro';
import { siteConfig } from '@/config/site.config';

const { vehicles, company, seo, location } = siteConfig;
const defaultVehicle = vehicles.find((v) => v.isDefault) ?? vehicles[0];
const otherVehicles = vehicles.filter((v) => !v.isDefault);

const title = `Nos Véhicules VTC — ${company.name} | ${location.city}`;
const description = vehicles
    .map((v) => `${v.name} ${v.model} (${v.type}, ${v.passengerCapacity} passagers)`)
    .join(' · ');
---

<Layout title={title} description={description}>

    <section class="page-hero">
        <div class="container">
            <h1>
                {vehicles.length === 1
                    ? `Notre Véhicule : ${defaultVehicle.name} ${defaultVehicle.model}`
                    : `Notre Flotte (${vehicles.length} véhicules)`}
            </h1>
            <p class="subtitle">
                Le choix d'une expérience de voyage <strong>premium</strong>,
                <strong>sécurisée</strong> et <strong>respectueuse de l'environnement</strong>.
            </p>
        </div>
    </section>

    {vehicles.map((vehicle, index) => (
        <section class:list={["vehicle-section", { "alt-bg": index % 2 !== 0 }]}>
            <div class="container">
                {vehicles.length > 1 && (
                    <div class="vehicle-header">
                        <span class:list={["vehicle-badge", { "badge-primary": vehicle.isDefault }]}>
                            {vehicle.isDefault ? "Véhicule principal" : "Véhicule disponible"}
                        </span>
                        <h2>{vehicle.name} {vehicle.model}</h2>
                        <p class="vehicle-type">{vehicle.type} — {vehicle.year}</p>
                    </div>
                )}

                <div class="vehicle-grid">
                    <div class="car-image">
                        <img
                            src={vehicle.mainImageUrl}
                            alt={`${vehicle.name} ${vehicle.model} — VTC ${location.city}`}
                            class="main-car-photo"
                        />
                        <div class="vehicle-specs">
                            <div class="spec-badge">
                                <span class="spec-icon">👥</span>
                                <span>{vehicle.passengerCapacity} passagers</span>
                            </div>
                            <div class="spec-badge">
                                <span class="spec-icon">🧳</span>
                                <span>{vehicle.luggageLiters} L</span>
                            </div>
                            {vehicle.electric && (
                                <div class="spec-badge electric">
                                    <span class="spec-icon">⚡</span>
                                    <span>100% électrique</span>
                                </div>
                            )}
                        </div>
                    </div>

                    <div class="features-list">
                        <h2>{vehicle.name} {vehicle.model} — Confort, Sécurité & Espace</h2>
                        <p>{vehicle.description}</p>

                        <ul class="key-features">
                            {vehicle.features.map((f) => (
                                <li>{f}</li>
                            ))}
                        </ul>

                        {vehicle.certifications.length > 0 && (
                            <div class="cert-list">
                                {vehicle.certifications.map((c) => (
                                    <span class="cert-badge">{c}</span>
                                ))}
                            </div>
                        )}
                    </div>
                </div>

                {vehicle.galleryImages.length > 0 && (
                    <div class="gallery">
                        {vehicle.galleryImages.map((img) => (
                            <img src={img.url} alt={img.alt} class="gallery-photo" />
                        ))}
                    </div>
                )}
            </div>
        </section>
    ))}

    {otherVehicles.length === 0 && (
        <section class="future-vehicles">
            <div class="container">
                <h2>Notre Flotte S'agrandit Bientôt !</h2>
                <p>
                    Afin de mieux répondre à vos besoins, {company.name} prévoit d'intégrer prochainement
                    de nouveaux véhicules VTC haut de gamme à sa flotte. Berline luxueuse, van spacieux
                    pour les groupes — nous diversifions notre offre tout en maintenant les mêmes standards
                    de qualité et de sécurité.
                </p>
            </div>
        </section>
    )}

    <section class="cta-section">
        <div class="container">
            <h2>Prêt à réserver ?</h2>
            <p>Obtenez une estimation instantanée et réservez en quelques clics.</p>
            <a href="/#booking" class="cta-button">Estimer mon trajet</a>
        </div>
    </section>

</Layout>

<style>
    :root {
        --accent: #007bff;
        --primary-text: #333;
        --secondary-bg: #f5f5f5;
    }

    .page-hero {
        background: var(--accent);
        color: white;
        padding: 4rem 2rem;
        text-align: center;
    }
    .page-hero h1 { font-size: clamp(2em, 4vw, 3em); margin-bottom: 0.5rem; }
    .subtitle { font-size: 1.2em; opacity: 0.9; }

    .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

    /* ---- Sections véhicule ---- */
    .vehicle-section { padding: 4rem 0; }
    .alt-bg { background-color: var(--secondary-bg); }

    .vehicle-header { text-align: center; margin-bottom: 2.5rem; }
    .vehicle-header h2 { font-size: clamp(1.8em, 3vw, 2.5em); color: var(--primary-text); margin: 0.5rem 0; }
    .vehicle-type { color: #666; font-size: 1.1em; }

    .vehicle-badge {
        display: inline-block;
        padding: 0.3rem 1rem;
        border-radius: 50px;
        font-size: 0.85em;
        font-weight: 600;
        background: #e9ecef;
        color: #555;
        margin-bottom: 0.5rem;
    }
    .badge-primary { background: var(--accent); color: white; }

    .vehicle-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        align-items: start;
    }
    @media (min-width: 900px) {
        .vehicle-grid { grid-template-columns: 1.2fr 1.5fr; }
    }

    .main-car-photo {
        width: 100%;
        height: auto;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        object-fit: cover;
    }

    /* Specs sous la photo */
    .vehicle-specs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1rem;
    }
    .spec-badge {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        background: white;
        border: 1px solid #ddd;
        border-radius: 50px;
        padding: 0.35rem 0.9rem;
        font-size: 0.9em;
        font-weight: 600;
        color: var(--primary-text);
    }
    .spec-badge.electric { background: #e8f5e9; border-color: #4caf50; color: #2e7d32; }
    .spec-icon { font-size: 1.1em; }

    /* Features */
    .features-list h2 { font-size: 1.6em; color: var(--primary-text); margin-bottom: 1rem; }
    .features-list p { color: #555; line-height: 1.7; margin-bottom: 1.5rem; }

    .key-features {
        list-style: none;
        padding: 0;
        margin: 0 0 1.5rem 0;
    }
    .key-features li {
        background: url('data:image/svg+xml;charset=utf-8,<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="%23007bff" viewBox="0 0 16 16"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.53a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.08z"/></svg>') no-repeat left center;
        background-size: 1em;
        padding-left: 1.8em;
        margin-bottom: 0.75em;
        line-height: 1.5;
        color: #444;
    }

    .cert-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .cert-badge {
        background: var(--accent);
        color: white;
        padding: 0.3rem 0.8rem;
        border-radius: 50px;
        font-size: 0.85em;
        font-weight: 600;
    }

    /* Galerie */
    .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
        margin-top: 2.5rem;
    }
    .gallery-photo {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    /* Section futurs véhicules */
    .future-vehicles {
        padding: 4rem 2rem;
        text-align: center;
        background-color: var(--dark-bg, #2d3a4c);
        color: white;
    }
    .future-vehicles h2 { color: var(--accent); margin-bottom: 1.5rem; font-size: clamp(1.8em, 3vw, 2.5em); }
    .future-vehicles p { max-width: 800px; margin: 0 auto; line-height: 1.7; font-size: 1.05em; color: #ccc; }

    /* CTA final */
    .cta-section { padding: 4rem 2rem; text-align: center; background: var(--secondary-bg); }
    .cta-section h2 { font-size: 2em; margin-bottom: 0.5rem; }
    .cta-section p { color: #666; margin-bottom: 2rem; }
    .cta-button {
        display: inline-block;
        padding: 1rem 2.5rem;
        background: var(--accent);
        color: white;
        text-decoration: none;
        border-radius: 50px;
        font-weight: bold;
        font-size: 1.1em;
        transition: background-color 0.3s ease, transform 0.3s ease;
    }
    .cta-button:hover { background: #0056b3; transform: translateY(-2px); }
</style>
